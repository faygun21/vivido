# Vivido web — ortam değişkenleri
#
# ⚠️ Vite `.env` dosyasını KENDİ kök klasöründen (web/) okur, deponun
# kökünden DEĞİL. Depo kökündeki .env içindeki VITE_* satırları buraya
# etki etmez — bu dosyayı `web/.env` olarak kopyalayın.
#
#   cp web/.env.example web/.env

# API kök adresi. Zaten /api/v1 ile biter — istek yollarına tekrar eklemeyin.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# MSW (sahte API) anahtarı.
#   false → gerçek backend'e bağlanır (dotnet run gerekir)
#   true / tanımsız → MSW devreye girer, backend gerekmez
VITE_USE_MOCKS=false

# ─── Harita altlığı ───
#
# ⭐ TERCİH EDİLEN: kendi vektör karo sunucumuz (sokaklar, binalar, su).
# Önce artefaktları edinin, sonra tileserver'ı açın:
#
#   ./data/scripts/00_fetch_artifacts.sh          # cankaya.mbtiles indirir
#   docker compose --profile routing up -d tileserver
#
# Boş bırakılırsa harita yalnızca GeoJSON katmanlarıyla çizilir
# (Çankaya sınırı + 124 mahalle) — sokak görünmez, ama çalışır.
#
# ⚠️ PORT 8081, 8080 DEĞİL.
# Konteyner İÇİNDE 8080 dinliyor ama `docker-compose.yml` onu ana
# makinede 8081'e açıyor (`TILESERVER_HOST_PORT:-8081`). Bu dosya uzun
# süre 8080 yazdı ve sonucu sinsiydi: harita AÇILIYOR, mahalle sınırları
# ve konut pinleri çiziliyor, yalnızca sokaklar/binalar/etiketler hiç
# gelmiyordu. Tarayıcı konsolunda tek satır hata yok — MapLibre
# ulaşamadığı bir kaynağı sessizce atlar.
VITE_TILE_URL=http://localhost:8081/data/v3.json

# Etiketler (yol/yer adları) için yazı tipi uç noktası. Tileserver sağlar.
# Bu adres yanlışsa sokaklar ÇİZİLİR ama üzerlerinde HİÇBİR AD görünmez.
VITE_GLYPHS_URL=http://localhost:8081/fonts/{fontstack}/{range}.pbf

# Son çare: public OSM raster karoları.
# ⚠️ docs/01-PROJE-PLANI.md §3 "Public OSM tile kullanılmaz" diyor.
# Yalnızca VITE_TILE_URL boşken ve sokakları görmek şartsa açın; demoya girmez.
VITE_USE_RASTER_BASEMAP=false
