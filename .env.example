# ══════════════════════════════════════════════════════════════
#  Vivido — ortam değişkenleri örneği
#  Kullanım:  copy .env.example .env    (Windows)
#             cp   .env.example .env    (WSL/Linux)
#  UYARI: Gerçek .env dosyası ASLA commit edilmez (.gitignore'da).
# ══════════════════════════════════════════════════════════════

# ─── PostgreSQL + PostGIS ───
# POSTGRES_PORT, host'ta dotnet run/appsettings'in bağlanacağı port —
# docker-compose PostGIS'i host'ta POSTGRES_HOST_PORT'a (5433) bağlar,
# 5432'ye DEĞİL. İkisi tutarsız olursa "password authentication failed
# for user vivido" alırsın (aslında port yanlış, parola değil).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_DB=vivido
POSTGRES_USER=vivido
POSTGRES_PASSWORD=degistir_beni_local_sifre

# .NET bağlantı dizesi (yukarıdakilerle tutarlı olmalı)
ConnectionStrings__Default=Host=localhost;Port=5433;Database=vivido;Username=vivido;Password=degistir_beni_local_sifre

# ─── Redis ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6380
ConnectionStrings__Redis=localhost:6379

# ─── JWT ───
# Üretimde mutlaka rastgele üret:  openssl rand -base64 48
Jwt__Issuer=vivido
Jwt__Audience=vivido-clients
Jwt__Key=local-gelistirme-icin-en-az-32-karakterlik-gecici-anahtar
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ─── E-posta doğrulama ve şifre sıfırlama (K-09) ───
#
# Kayıt olan kullanıcıya 6 haneli kod gider; kod girilene kadar giriş kapalı.
#
# ⚠️ GEÇİCİ: yerel geliştirmede KAPALI. Yeni özellikleri denerken her kayıtta
# terminalden 6 haneli kod kopyalamak akışı gereksiz yavaşlatıyordu. Kapalıyken
# kayıt eskisi gibi 201 + token döner ve doğrulama ekranı hiç açılmaz (K-09).
# ⭐ DOĞRULAMA AÇIK. Bir süre kapalıydı (her kayıtta 6 haneli kod girmek
# geliştirmeyi yavaşlatıyordu); akış yeniden test edileceği için geri açıldı.
# Artık yerel davranış staging/production ile AYNI.
#
# Kod e-posta ile GÖNDERİLMEZ: Email__Provider=console olduğu için api
# loglarına basılır → `docker compose logs -f api`
#
# Bu satır YALNIZCA docker-compose içindir. `pnpm dev:api` bu dosyayı OKUMAZ —
# onun karşılığı api/src/Vivido.Api/appsettings.Development.json içinde.
Auth__RequireEmailVerification=true

# ─── İlk admin ───
# Bu e-postayla GİRİŞ YAPAN kullanıcıya otomatik admin yetkisi verilir.
# BOŞ BIRAKILIRSA ADMIN PANELİ KULLANILAMAZ: "admin yap" ucu zaten admin
# olmayı gerektiriyor, yani kısır döngü oluşur.
# Yetki girişte veriliyor — kullanıcının önce kayıt olup e-postasını
# doğrulamış olması gerekir.
BootstrapAdmin__Email=
Auth__VerificationCodeMinutes=15
Auth__PasswordResetCodeMinutes=15
Auth__MaxCodeAttempts=5
Auth__ResendCooldownSeconds=60

# ⭐ E-posta sağlayıcısı
#   console → e-posta GÖNDERİLMEZ, kod `pnpm dev:api` konsoluna basılır.
#             Kimlik bilgisi gerekmez; ekipteki herkes akışı böyle deneyebilir.
#   smtp    → gerçek gönderim.
Email__Provider=console

# ─── Gmail SMTP (Email__Provider=smtp ise) ───
#
# ⚠️ Email__Password Gmail hesabının NORMAL ŞİFRESİ DEĞİLDİR.
# Google 2022'den beri normal şifreyle SMTP girişini reddediyor.
# 16 haneli "Uygulama Şifresi" gerekir — adımlar için README §2.5.
#
#   1. Google hesabında 2 Adımlı Doğrulama AÇIK olmalı
#   2. https://myaccount.google.com/apppasswords → yeni uygulama şifresi
#   3. Çıkan 16 haneli değeri boşluksuz aşağıya yaz
Email__Host=smtp.gmail.com
Email__Port=587
Email__User=ornek@gmail.com
Email__Password=xxxxxxxxxxxxxxxx
Email__FromAddress=ornek@gmail.com
Email__FromName=Vivido

# ─── OSRM (Hafta 2'de devreye girer) ───
# ⚠️ Bu portlar aşağıdaki OSRM_FOOT_HOST_PORT/OSRM_CAR_HOST_PORT
# (docker-compose'un konteynerleri host'a bağladığı gerçek portlar) ile
# AYNI OLMAK ZORUNDA. Eskiden 5001/5002 yazıyordu — docker-compose.yml'deki
# fiili varsayılanlarla (5101/5102) uyuşmuyordu, host'ta (docker DIŞINDA)
# `dotnet run` ile çalışan API rota oluşturmada sessizce OSRM_UNAVAILABLE
# (503) veriyordu çünkü o portlarda hiçbir şey dinlemiyordu (2026-08-31,
# E2E test paketi hazırlanırken bulundu).
Routing__FootUrl=http://localhost:5101
Routing__CarUrl=http://localhost:5102
Routing__MaxTableSize=200

# ─── Harita tile sunucusu (Hafta 2'de devreye girer) ───
Tiles__BaseUrl=http://localhost:8080
Tiles__StyleUrl=http://localhost:8080/styles/basic/style.json

# ─── API ───
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000
API_HOST_PORT=5003

# ─── Web (Vite) ───
# DİKKAT: bu değer ZATEN /api/v1 ile biter. İstek yollarına tekrar ekleme.
VITE_API_BASE_URL=http://localhost:5003/api/v1
VITE_TILE_STYLE_URL=http://localhost:8081/styles/basic/style.json
VITE_TILE_URL=http://localhost:8081/data/v3.json
VITE_GLYPHS_URL=http://localhost:8081/fonts/{fontstack}/{range}.pbf
WEB_HOST_PORT=8082

# MSW (sahte API) açık mı?
# Hafta 1'de backend hazır olmadığı için varsayılan AÇIK — boş bırakılırsa
# geliştirmede otomatik devreye girer. Backend endpoint'leri yayınlandıkça
# web/src/mocks/handlers/ altındaki ilgili dosya silinir; hepsi bitince
# buraya false yazılır. Üretim derlemesinde hiçbir koşulda çalışmaz.
VITE_USE_MOCKS=true

# ─── Mobil (Expo) ───
# Fiziksel cihazdan test ederken localhost ÇALIŞMAZ.
# Bilgisayarının yerel IP'sini yaz:  ipconfig  →  IPv4 Address
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:5000/api/v1
EXPO_PUBLIC_TILE_STYLE_URL=http://192.168.1.100:8080/styles/basic/style.json

# ─── Veri sürümü ───
# ETL çıktısının hangi OSM anlık görüntüsünden geldiği. Proje boyunca DONDURULUR.
DATA_VERSION=osm-2026-08-20
SCORING_VERSION=1.0.0

# ─── Docker host portları ───
PGADMIN_HOST_PORT=5051
OSRM_FOOT_HOST_PORT=5101
OSRM_CAR_HOST_PORT=5102
TILESERVER_HOST_PORT=8081

# ─── pgAdmin ───
PGADMIN_DEFAULT_EMAIL=dev@vivido.dev
PGADMIN_DEFAULT_PASSWORD=degistir_beni_pgadmin_sifresi
