# Vivido staging — ters vekil ve otomatik HTTPS.
#
# ⭐ TEK ORIGIN. Web, API ve karolar AYNI adres altında yol bazlı dağıtılıyor:
#
#     /            →  web        (nginx, Vite çıktısı)
#     /api/*       →  api        (.NET, :5000)
#     /tiles/*     →  tileserver (:8080)
#
# Neden api.domain.xyz gibi ayrı alt alan adı değil: aynı origin olunca
# CORS tamamen ortadan kalkıyor. Şu an `Program.cs` CORS'u yalnızca
# Development'ta açıyor; ayrı origin seçilseydi production'da web API'ye
# hiç erişemezdi. Ayrıca ileride refresh token'ı httpOnly cookie'ye taşımak
# isterseniz (K-A'daki bilinen takas) yol açık kalıyor.
#
# ── ADRES: tek satırla IP ↔ domain geçişi ──
#
# SITE_ADDRESS ortam değişkeni .env'den geliyor:
#
#   :80                → HTTP, ham IP ile erişim. Domain gelmeden test için.
#   vividoapp.xyz      → Caddy Let's Encrypt sertifikasını KENDİ alır ve
#                        otomatik yeniler. HTTP'den HTTPS'e yönlendirme de
#                        kendiliğinden kurulur.
#
# ⚠️ Domain moduna geçmeden önce A kaydı sunucuya çözümleniyor OLMALI.
# Çözümlenmiyorsa Let's Encrypt doğrulaması başarısız olur ve Caddy
# tekrar tekrar dener (rate limit'e takılabilirsiniz).

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# ⭐ SERTİFİKA ZİNCİRİ — bunu kaldırma, site Windows'ta güvensiz görünür.
	#
	# Let's Encrypt 7 Ocak 2026'da "Generation Y" hiyerarşisine geçti
	# (Root YE / Root YR). Caddy varsayılan olarak o zinciri seçiyor, ama
	# bu kökler HENÜZ hiçbir büyük güven deposunda yok. Sonuç:
	#
	#   OpenSSL         → Verification: OK
	#   Windows Chrome  → NET::ERR_CERT_AUTHORITY_INVALID
	#   iPhone Safari   → sorunsuz
	#
	# Yani hata istemciye göre değişiyor ve "bende çalışıyor" tuzağının
	# ders kitabı örneği. Zincirde ISRG Root X1'e çapraz imza olmasına
	# rağmen Windows schannel o yoldan güvenilir köke ulaşamıyor.
	#
	# ⭐ `key_type rsa2048` ASIL DÜZELTME, süs değil.
	#
	# Ölçülen durum: bu ekipteki Windows makinesinin güven deposunda
	# `ISRG Root X1` VAR ama `ISRG Root X2` YOK. Varsayılan ECDSA anahtarla
	# Let's Encrypt şu zinciri veriyor:
	#
	#     leaf ← YE2 ← Root YE ← ISRG Root X2 ← ISRG Root X1
	#                            ^^^^^^^^^^^^ Windows bunu tanımıyor
	#
	# RSA anahtarla YR hiyerarşisi devreye giriyor ve doğrudan
	# ISRG Root X1'e çapraz imzalı — X2 yolundan hiç geçmiyor.
	#
	# Bedeli: RSA imzalar ECDSA'dan biraz yavaş ve sertifika birkaç yüz
	# bayt büyük. Bir demo sitesinde ölçülemez; "jürinin makinesinde kırmızı
	# uyarı çıkması" riskinin yanında hiçbir şey.
	tls {
		key_type rsa2048
		issuer acme {
			preferred_chains {
				root_common_name "ISRG Root X1"
			}
		}
	}

	# ── Karo sunucusu ──
	#
	# `handle_path` ön eki SOYAR: /tiles/data/v3.json → /data/v3.json
	#
	# ⚠️ tileserver-gl ürettiği TileJSON'un içine karoların MUTLAK adresini
	# yazıyor. Ön eki bilmediği için varsayılan olarak `/data/{z}/{x}/{y}.pbf`
	# üretir — ama dışarıdan doğru adres `/tiles/data/...`. Bu yüzden
	# docker-compose.prod.yml'de tileserver'a `--public_url` veriliyor.
	# Harita boş çıkarsa BAKILACAK İLK YER burasıdır.
	handle_path /tiles/* {
		reverse_proxy tileserver:8080
	}

	# ── API ──
	# Ön ek SOYULMUYOR (`handle`, `handle_path` değil): .NET tarafında
	# rotalar zaten `api/v1/...` olarak tanımlı.
	handle /api/* {
		reverse_proxy api:5000
	}

	# ── Sağlık kontrolü ──
	#
	# ⚠️ `Program.cs` sağlık uçlarını KÖKTE tanımlıyor (`/health/ready`),
	# controller'lar gibi `api/v1/...` altında DEĞİL. Bu yüzden ayrı bir
	# handle gerekiyor; `/api/v1/health/ready` denemesi 404 döner.
	handle /health/* {
		reverse_proxy api:5000
	}

	# ── Web (varsayılan) ──
	handle {
		reverse_proxy web:80
	}

	# Sunucu yazılımını ve sürümünü duyurma.
	header -Server

	# HTTPS aktifken tarayıcıya "bu siteye bir daha HTTP ile gelme" de.
	# ⚠️ Yalnızca domain modunda anlamlı; :80 modunda tarayıcı yok sayar.
	header Strict-Transport-Security "max-age=31536000;"

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
