# ══════════════════════════════════════════════════════════════
#  Vivido staging — sunucudaki ortam değişkenleri
#
#  Bu dosya SUNUCUDA `/opt/vivido/.env` olarak durur.
#  ⛔ Gerçek .env ASLA git'e girmez (.gitignore'da).
#
#  Kurulum:  cp deploy/.env.example /opt/vivido/.env  &&  nano /opt/vivido/.env
# ══════════════════════════════════════════════════════════════

# ─── Adres ───
#
# İKİ MODU VAR, tek satırla geçiş yapılıyor:
#
#   :80              → ham IP üzerinden HTTP. Domain gelmeden test için.
#   vividoapp.xyz    → Caddy Let's Encrypt sertifikasını KENDİ alır,
#                      HTTP→HTTPS yönlendirmesini KENDİ kurar.
#
# ⚠️ Domain moduna geçmeden önce A kaydı bu sunucuya çözümleniyor olmalı.
# Çözümlenmiyorsa sertifika alınamaz ve Caddy denemeye devam eder
# (Let's Encrypt rate limit'ine takılabilirsiniz).
SITE_ADDRESS=:80

# Karo sunucusunun DIŞARIDAN görünen adresi.
#
# ⭐ Bu ayar olmadan harita altlığı BOŞ çizilir ve hata da vermez.
# Sebep: tileserver TileJSON içine karoların mutlak adresini yazıyor;
# Caddy `/tiles` ön ekini soyduğu için ön eki buradan söylemek gerekiyor.
#
#   IP modunda    : http://<SUNUCU_IP>/tiles/
#   domain modunda: https://vividoapp.xyz/tiles/
PUBLIC_TILE_URL=http://SUNUCU_IP_YAZ/tiles/

# ─── Veritabanı ───
# ⚠️ İLK `up` KOMUTUNDAN SONRA DEĞİŞTİRİLEMEZ. Postgres volume'ü bu
# parolayla oluşuyor; sonradan değiştirirseniz kimlik doğrulama hatası
# alırsınız (bu tuzağa yerelde bir kez düşüldü).
POSTGRES_DB=vivido
POSTGRES_USER=vivido
POSTGRES_PASSWORD=BURAYA_UZUN_RASTGELE_PAROLA

# ─── JWT ───
# ⚠️ appsettings.Development.json'daki anahtar git'te DURUYOR ve
# production'a ASLA gelmez. Bu anahtarı bilen herkes istediği kullanıcı
# adına geçerli token üretebilir.
#
#   openssl rand -base64 48
Jwt__Key=BURAYA_OPENSSL_CIKTISI
Jwt__Issuer=vivido-api
Jwt__Audience=vivido-web
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14

# ─── CORS ───
# Tek origin kurulumunda BOŞ BIRAKIN — web ve API aynı adresten
# sunulduğu için tarayıcı CORS'a hiç takılmıyor. Boş = CORS kapalı.
# Yalnızca web'i ayrı bir adresten sunarsanız doldurun:
#   Cors__AllowedOrigins=https://baska-adres.xyz,https://ikinci.xyz
Cors__AllowedOrigins=

# ─── E-posta (K-09) ───
# Staging'de gerçek gönderim: Gmail uygulama şifresi (README §2.5).
# Ekipteki kimsenin ayrı SMTP kurmasına gerek yok — tek yapılandırma
# herkese hizmet ediyor.
Auth__RequireEmailVerification=true

# ─── İlk admin ───
# Bu e-postayla GİRİŞ YAPAN kullanıcıya otomatik admin yetkisi verilir.
# BOŞ BIRAKILIRSA ADMIN PANELİ KULLANILAMAZ: "admin yap" ucu zaten admin
# olmayı gerektiriyor, yani kısır döngü oluşur.
# Yetki girişte veriliyor — kullanıcının önce kayıt olup e-postasını
# doğrulamış olması gerekir.
BootstrapAdmin__Email=
Email__Provider=smtp
Email__Host=smtp.gmail.com
Email__Port=587
Email__User=gonderici@gmail.com
Email__Password=BURAYA_16_HANELI_UYGULAMA_SIFRESI
Email__FromAddress=gonderici@gmail.com
Email__FromName=Vivido

# ─── İmaj sürümü ───
# `latest` yerine commit SHA yazmak geri dönüşü tek satıra indirir.
IMAGE_TAG=latest
